              "drawStyle": "line",
              "lineInterpolation": "smooth",
              "lineWidth": 2,
              "fillOpacity": 12,
              "showPoints": "never"
            },
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {"color": "green", "value": null},
                {"color": "yellow", "value": 2000},
                {"color": "red", "value": 2400}
              ]
            }
          },
          "overrides": [
            {
              "matcher": {"id": "byName", "options": "power_usage_kwh"},
              "properties": [
                {"id": "displayName", "value": "Power Usage"},
                {"id": "color", "value": {"mode": "fixed", "fixedColor": "green"}},
                {"id": "custom.drawStyle", "value": "bars"},
                {"id": "custom.fillOpacity", "value": 85}
              ]
            },
            {
              "matcher": {"id": "byName", "options": "generated_kwh"},
              "properties": [
                {"id": "displayName", "value": "Generated Power"},
                {"id": "color", "value": {"mode": "fixed", "fixedColor": "orange"}},
                {"id": "custom.drawStyle", "value": "line"},
                {"id": "custom.lineWidth", "value": 3}
              ]
            },
            {
              "matcher": {"id": "byName", "options": "co2_kg"},
              "properties": [
                {"id": "displayName", "value": "CO2 Emissions"},
                {"id": "unit", "value": "short"},
                {"id": "color", "value": {"mode": "fixed", "fixedColor": "light-blue"}},
                {"id": "custom.drawStyle", "value": "line"},
                {"id": "custom.fillOpacity", "value": 20}
              ]
            }
          ]
        },
        "options": {
          "legend": {"displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull", "mean", "max"]},
          "tooltip": {"mode": "multi", "sort": "none"}
        }
      },
      {
        "id": 5,
        "type": "piechart",
        "title": "Power Distribution by Category",
        "description": "Monthly energy consumption distribution by equipment category.",
        "datasource": {"type": "grafana-testdata-datasource", "uid": "testdata"},
        "gridPos": {"h": 12, "w": 13, "x": 0, "y": 16},
        "targets": [
          {
            "refId": "A",
            "datasource": {"type": "grafana-testdata-datasource", "uid": "testdata"},
            "scenarioId": "csv_content",
            "csvContent": "category,kwh\nMachining Center,19477.17\nMolding Machine,13863.64\nAir Conditioning,6646.12\n2F Main Feeder,2915.91\nLighting,419.50\nVending Machine,190.83\nCompressor,108.53\n2F Lighting Warehouse,88.86\n2F Lighting Corridor,42.53\nElevator,6.44"
          }
        ],
        "fieldConfig": {
          "defaults": {"unit": "kwatth", "decimals": 2},
          "overrides": []
        },
        "options": {
          "pieType": "donut",
          "displayLabels": ["name", "value", "percent"],
          "legend": {"displayMode": "table", "placement": "bottom", "showLegend": true, "values": ["value", "percent"]},
          "reduceOptions": {"values": true, "calcs": ["lastNotNull"], "fields": ""}
        }
      },
      {
        "id": 6,
        "type": "table",
        "title": "Device Communication Status",
        "description": "IoT device heartbeat and communication status.",
        "datasource": {"type": "grafana-testdata-datasource", "uid": "testdata"},
        "gridPos": {"h": 12, "w": 11, "x": 13, "y": 16},
        "targets": [
          {
            "refId": "A",
            "datasource": {"type": "grafana-testdata-datasource", "uid": "testdata"},
            "scenarioId": "csv_content",
            "csvContent": "device,area,status,last_seen,message\nPM-001,Machining Center,ONLINE,__NOW_MINUS_12S__,collecting normally\nPM-002,Molding Machine,ONLINE,__NOW_MINUS_16S__,collecting normally\nPM-003,Air Conditioning,WARN,__NOW_MINUS_3M__,delayed heartbeat\nPM-004,2F Main Feeder,ONLINE,__NOW_MINUS_22S__,collecting normally\nPM-005,Lighting,ONLINE,__NOW_MINUS_26S__,collecting normally\nPM-006,Compressor,WARN,__NOW_MINUS_4M__,packet loss detected\nPM-007,Elevator,OFFLINE,__NOW_MINUS_19M__,no data for 19 minutes"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "custom": {
              "align": "auto",
              "cellOptions": {"type": "auto"}
            }
          },
          "overrides": [
            {
              "matcher": {"id": "byName", "options": "status"},
              "properties": [
                {"id": "custom.cellOptions", "value": {"type": "color-text"}},
                {
                  "id": "mappings",
                  "value": [
                    {
                      "type": "value",
                      "options": {
                        "ONLINE": {"color": "green", "index": 0},
                        "WARN": {"color": "yellow", "index": 1},
                        "OFFLINE": {"color": "red", "index": 2}
                      }
                    }
                  ]
                }
              ]
            }
          ]
        },
        "options": {
          "showHeader": true,
          "cellHeight": "sm",
          "footer": {"show": false}
        }
      }
    ]
