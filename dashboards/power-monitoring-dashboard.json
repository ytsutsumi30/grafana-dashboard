    "panels": [
      {
        "id": 1,
        "type": "stat",
        "title": "Current Power Usage",
        "description": "Mock range: 50-500 kW. Latest total demand.",
        "datasource": {"type": "grafana-testdata-datasource", "uid": "testdata"},
        "gridPos": {"h": 5, "w": 8, "x": 0, "y": 0},
        "targets": [
          {
            "refId": "A",
            "datasource": {"type": "grafana-testdata-datasource", "uid": "testdata"},
            "scenarioId": "random_walk",
            "alias": "Current Power Usage",
            "seriesCount": 1,
            "min": 50,
            "max": 500
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "kwatt",
            "min": 50,
            "max": 500,
            "decimals": 1,
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {"color": "green", "value": null},
                {"color": "yellow", "value": 350},
                {"color": "red", "value": 450}
              ]
            }
          },
          "overrides": []
        },
        "options": {
          "reduceOptions": {"values": false, "calcs": ["lastNotNull"], "fields": ""},
          "orientation": "horizontal",
          "textMode": "auto",
          "colorMode": "background",
          "graphMode": "area",
          "justifyMode": "center"
