        "gridPos": {"h": 5, "w": 8, "x": 16, "y": 0},
        "targets": [
          {
            "refId": "A",
            "datasource": {"type": "grafana-testdata-datasource", "uid": "testdata"},
            "scenarioId": "random_walk",
            "alias": "CO2 Emissions",
            "seriesCount": 1,
            "min": 100,
            "max": 1200
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "short",
            "min": 100,
            "max": 1200,
            "decimals": 1,
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {"color": "green", "value": null},
                {"color": "yellow", "value": 800},
                {"color": "red", "value": 1000}
              ]
            }
          },
          "overrides": []
