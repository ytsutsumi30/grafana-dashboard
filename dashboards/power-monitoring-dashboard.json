        "fieldConfig": {
          "defaults": {
            "unit": "kwatt",
            "min": 0,
            "max": 120,
            "decimals": 1,
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {"color": "red", "value": null},
                {"color": "yellow", "value": 20},
                {"color": "green", "value": 60}
              ]
            }
          },
          "overrides": []
        },
        "options": {
          "reduceOptions": {"values": false, "calcs": ["lastNotNull"], "fields": ""},
          "orientation": "auto",
          "showThresholdLabels": false,
          "showThresholdMarkers": true
